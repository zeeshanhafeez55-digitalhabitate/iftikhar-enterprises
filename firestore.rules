rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isActive() {
      return userDoc().data.active == true;
    }

    function hasPerm(module, action) {
      return isSignedIn() && isActive() &&
        get(/databases/$(database)/documents/roles/$(role())).data.permissions[module][action] == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && isActive() && role() == 'SUPER_ADMIN';
    }

    // Users can read their own doc; only Super Admin/Admin manage users
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || hasPerm('users', 'view'));
      allow create, update, delete: if isSuperAdmin() || hasPerm('users', 'edit');
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /businesses/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || hasPerm('settings', 'edit');
    }

    match /branches/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || hasPerm('settings', 'edit');
    }

    match /warehouses/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || hasPerm('settings', 'edit');
    }

    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || hasPerm('settings', 'edit');
    }

    match /categories/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || hasPerm('products', 'edit');
    }

    match /brands/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || hasPerm('products', 'edit');
    }

    match /products/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSuperAdmin() || hasPerm('products', 'edit');
      allow delete: if isSuperAdmin() || hasPerm('products', 'delete');
    }

    match /customers/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('customers', 'view'));
      allow create, update: if isSuperAdmin() || hasPerm('customers', 'edit');
      allow delete: if isSuperAdmin() || hasPerm('customers', 'delete');
    }

    match /suppliers/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('suppliers', 'view'));
      allow create, update: if isSuperAdmin() || hasPerm('suppliers', 'edit');
      allow delete: if isSuperAdmin() || hasPerm('suppliers', 'delete');
    }

    match /sales/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('sales', 'view'));
      allow create: if isSuperAdmin() || hasPerm('sales', 'create');
      allow update: if isSuperAdmin() || hasPerm('sales', 'edit');
      allow delete: if isSuperAdmin() || hasPerm('sales', 'delete');
    }

    match /saleItems/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('sales', 'view'));
      allow write: if isSuperAdmin() || hasPerm('sales', 'create');
    }

    match /saleReturns/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('sales', 'view'));
      allow write: if isSuperAdmin() || hasPerm('sales', 'refund');
    }

    match /purchases/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('purchases', 'view'));
      allow create, update: if isSuperAdmin() || hasPerm('purchases', 'edit');
      allow delete: if isSuperAdmin() || hasPerm('purchases', 'delete');
    }

    match /purchaseItems/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('purchases', 'view'));
      allow write: if isSuperAdmin() || hasPerm('purchases', 'edit');
    }

    match /purchaseReturns/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('purchases', 'view'));
      allow write: if isSuperAdmin() || hasPerm('purchases', 'edit');
    }

    match /stockMovements/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('stock', 'view'));
      // stock movements are written by trusted server logic / trusted client flows only
      allow create: if isSuperAdmin() || hasPerm('stock', 'edit');
      allow update, delete: if false;
    }

    match /payments/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('reports', 'view'));
      allow create: if isSuperAdmin() || hasPerm('sales', 'create') || hasPerm('purchases', 'edit');
      allow update, delete: if isSuperAdmin();
    }

    match /expenses/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('expenses', 'view'));
      allow create, update: if isSuperAdmin() || hasPerm('expenses', 'edit');
      allow delete: if isSuperAdmin() || hasPerm('expenses', 'delete');
    }

    match /cashTransactions/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('reports', 'view'));
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /customerLedger/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('customers', 'view'));
      allow create: if isSuperAdmin() || hasPerm('sales', 'create') || hasPerm('customers', 'edit');
      allow update, delete: if false; // ledger entries are append-only
    }

    match /supplierLedger/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('suppliers', 'view'));
      allow create: if isSuperAdmin() || hasPerm('purchases', 'edit') || hasPerm('suppliers', 'edit');
      allow update, delete: if false; // ledger entries are append-only
    }

    match /customOrders/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && hasPerm('sales', 'view'));
      allow create, update: if isSuperAdmin() || hasPerm('sales', 'create');
      allow delete: if isSuperAdmin() || hasPerm('sales', 'delete');
    }

    match /deliveries/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || hasPerm('sales', 'edit');
    }

    match /auditLogs/{id} {
      allow read: if isSuperAdmin() || hasPerm('reports', 'view');
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
